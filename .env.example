# Токен бота от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес, по которому открывается игра (без / в конце)
WEBAPP_URL=https://gomoku.example.com

# Порт и адрес, на которых слушает сервер (за Caddy/nginx — 127.0.0.1)
PORT=3000
HOST=127.0.0.1

# Необязательно: короткое имя Mini App, созданного через /newapp в @BotFather.
# Если задано, ссылка-приглашение сразу открывает игру, а не чат с ботом.
MINIAPP_NAME=

# 1 = режим разработки: игру можно открыть в обычном браузере без Telegram,
# имя игрока задаётся параметром ?as=Имя. На сервере держите 0.
DEV=0

# Где хранить партии (по умолчанию data/db.json)
# DATA_FILE=data/db.json
